# Local Database Credentials for Docker Compose
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=password
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=password

# MongoDB Connection String (Should match credentials above)
MONGODB_URI=mongodb://admin:password@localhost:27017/modlist?authSource=admin

# Discord OAuth2 Credentials (Get these from https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# JWT Token Signing Secret (Any long random string)
JWT_SECRET=super_secret_session_token_key_change_in_production_123!

# Admin Discord User IDs (Comma-separated list of Discord user IDs who should be admins)
# Example: 123456789012345678,987654321098765432
ADMIN_DISCORD_IDS=

# Discord Webhook URL for announcing new mods
DISCORD_WEBHOOK_URL=
# Application Base URL (for generating mod links in Discord announcements)
APP_BASE_URL=http://localhost:3000

# Google AdSense Client Publisher ID
ADSENSE_CLIENT_ID=
