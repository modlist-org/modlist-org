# Local development secrets. `bun run dev` / `bun run preview` read these from .dev.vars
# (copy this file to .dev.vars). In production they are Worker secrets:
#   wrangler secret put NUXT_JWT_SECRET   (etc.)

# Discord OAuth2 Credentials (https://discord.com/developers/applications)
NUXT_DISCORD_CLIENT_ID=your_discord_client_id_here
NUXT_DISCORD_CLIENT_SECRET=your_discord_client_secret_here
NUXT_DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# JWT Token Signing Secret (Any long random string)
NUXT_JWT_SECRET=change_me_to_a_long_random_string

# Admin Discord User IDs (comma-separated)
NUXT_ADMIN_DISCORD_IDS=

# Discord Webhook URL for announcing new mods
NUXT_DISCORD_WEBHOOK_URL=
# Public site URL (used for links in Discord announcements)
NUXT_SITE_URL=http://localhost:3000

NUXT_DISCORD_MOD_PING_ROLE_ID_ADOFAI=
NUXT_DISCORD_MOD_PING_ROLE_ID_RHYTHM_DOCTOR=
NUXT_DISCORD_MOD_PING_ROLE_ID_DANCING_LINE=

NUXT_DISCORD_MOD_ALL_ROLE_ID_ADOFAI=
NUXT_DISCORD_MOD_ALL_ROLE_ID_RHYTHM_DOCTOR=
NUXT_DISCORD_MOD_ALL_ROLE_ID_DANCING_LINE=
